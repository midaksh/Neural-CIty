    "population_source": "data/raw/population-data.csv (Census 2011)",
    "weights": {
      "bus": "1.0 (400m catchment baseline)",
      "railway": "6.25 (1000m catchment, r\u00b2 ratio 6.25)",
      "metro": "4.0 (800m catchment, r\u00b2 ratio 4.0)"
    },
    "formula": {
      "weighted_stops": "bus\u00d71.0 + railway\u00d76.25 + metro\u00d74.0",
      "coverage_density": "weighted_stops / city_area_km\u00b2",
      "access_per_100k": "weighted_stops / population \u00d7 100,000",
      "composite": "spatial_score\u00d70.55 + access_score\u00d70.45 (fair trade: land coverage vs resident access)"
    },
    "classification": {
      "bus": "highway=bus_stop",
      "railway": "railway=station|halt",
      "metro": "station=subway|metro|monorail OR railway=stop"
    },
    "normalization": "Sqrt-compress each raw metric, scale to 15\u2013100, then blend; higher = better",
    "bands": {
      "poor": "0\u201335",
      "manageable": "35\u201365",
      "good": "65+"
    },
    "cities_processed": 11
  },
